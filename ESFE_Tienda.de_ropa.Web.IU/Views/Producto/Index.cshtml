@{
    ViewData["Title"] = "Catálogo de Productos - Claret Style";
}

<style>
    .card-dark-custom {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        color: #fff;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .card-dark-custom:hover {
        transform: translateY(-5px);
        border-color: #800e24;
    }

    .btn-vino {
        background: linear-gradient(135deg, #800e24, #b21323) !important;
        color: #fff !important;
        border: none !important;
        box-shadow: 0 4px 12px rgba(128, 14, 36, 0.4) !important;
        transition: all 0.3s ease !important;
    }

    .btn-vino:hover {
        background: linear-gradient(135deg, #a0122d, #d91b2c) !important;
        box-shadow: 0 8px 25px rgba(217, 27, 44, 0.6) !important;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-white mb-0">🔥 Colección Destacada</h2>
