@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="container mt-4">
    <!-- Encabezado con Botón -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-primary">👔 Catálogo de Productos</h2>
            <p class="text-muted">Administración y maquetación de productos de la tienda de ropa</p>
        </div>
        <button type="button" class="btn btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalProducto">
            + Nuevo Producto
        </button>
    </div>

    <!-- Tabla Maquetada con Bootstrap -->
    <div class="card shadow-sm mb-5">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0" id="tablaProductos">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td><strong>Camisa Casual Slim Fit</strong></td>
                        <td><span class="badge bg-info text-dark">Ropa Masculina</span></td>
                        <td>$25.00</td>
                        <td><span class="badge bg-success">15 dispon.</span></td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-warning text-white fw-bold me-1" onclick="editar('Camisa Casual Slim Fit')">Editar</button>
                            <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="eliminar(this, 'Camisa Casual Slim Fit')">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td><strong>Jeans Mezclilla Azul</strong></td>
                        <td><span class="badge bg-info text-dark">Pantalones</span></td>
                        <td>$38.50</td>
                        <td><span class="badge bg-success">8 dispon.</span></td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-warning text-white fw-bold me-1" onclick="editar('Jeans Mezclilla Azul')">Editar</button>
                            <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="eliminar(this, 'Jeans Mezclilla Azul')">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td><strong>Chaqueta de Cuero Negra</strong></td>
                        <td><span class="badge bg-info text-dark">Abrigos</span></td>
                        <td>$75.00</td>
                        <td><span class="badge bg-warning text-dark">2 dispon.</span></td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-warning text-white fw-bold me-1" onclick="editar('Chaqueta de Cuero Negra')">Editar</button>
                            <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="eliminar(this, 'Chaqueta de Cuero Negra')">Eliminar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal / Formulario para Agregar Producto -->
<div class="modal fade" id="modalProducto" tabindex="-1" aria-labelledby="modalProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalProductoLabel">Registrar Nuevo Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formNuevoProducto">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre del Producto</label>
                        <input type="text" id="nombreProducto" class="form-control" placeholder="Ej: Vestido Elegante" required>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Precio ($)</label>
                            <input type="number" step="0.01" id="precioProducto" class="form-control" placeholder="0.00" required>
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label fw-bold">Cantidad Stock</label>
                            <input type="number" id="stockProducto" class="form-control" placeholder="0" required>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarProducto()">Guardar Producto</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let contadorID = 4;

        function guardarProducto() {
            const nombre = document.getElementById('nombreProducto').value;
            const precio = document.getElementById('precioProducto').value;
            const stock = document.getElementById('stockProducto').value;

            if (!nombre || !precio || !stock) {
                alert('Por favor completa todos los campos.');
                return;
            }

            // Insertar la nueva fila en la tabla
            const tbody = document.querySelector('#tablaProductos tbody');
            const nuevaFila = `
                <tr>
                    <td>${contadorID++}</td>
                    <td><strong>${nombre}</strong></td>
                    <td><span class="badge bg-info text-dark">Nuevo Ingreso</span></td>
                    <td>$${parseFloat(precio).toFixed(2)}</td>
                    <td><span class="badge bg-success">${stock} dispon.</span></td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-warning text-white fw-bold me-1" onclick="editar('${nombre}')">Editar</button>
                        <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="eliminar(this, '${nombre}')">Eliminar</button>
                    </td>
                </tr>
            `;
            tbody.innerHTML += nuevaFila;

            // Resetear el formulario
            document.getElementById('formNuevoProducto').reset();

            // Cerrar el modal
            const modalElement = document.getElementById('modalProducto');
            const modalInstance = bootstrap.Modal.getInstance(modalElement);
            modalInstance.hide();

            alert('¡Producto "' + nombre + '" guardado exitosamente!');
        }

        function editar(nombre) {
            alert('Editar producto: ' + nombre);
        }

        function eliminar(boton, nombre) {
            if(confirm('¿Estás seguro de eliminar ' + nombre + '?')) {
                // Elimina la fila visualmente
                const fila = boton.closest('tr');
                fila.remove();
                alert('Producto eliminado correctamente.');
            }
        }
    </script>
}
