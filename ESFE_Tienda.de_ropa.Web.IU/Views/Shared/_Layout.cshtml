<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Claret Style</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/style.css" />
</head>
<body style="background-color: #121212; color: #fff;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm style-navbar" style="background-color: #800e24; padding: 10px 20px;">
            <div class="container-fluid d-flex justify-content-between align-items-center">
                <a class="navbar-brand text-white fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    🛍️ Claret Style
                </a>
                
                <div class="d-flex align-items-center gap-3">
                    <!-- Rutas con controladores para no perder la sesión -->
                    <a class="text-white text-decoration-none px-2" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                    <a class="text-white text-decoration-none px-2" asp-area="" asp-controller="Producto" asp-action="Index">Productos</a>
                    
                    <!-- Partial del Login para mantener la autenticación -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

