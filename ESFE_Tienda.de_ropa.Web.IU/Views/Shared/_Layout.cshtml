<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Claret Style</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ESFE_Tienda_de_ropa.Web.UI.styles.css" asp-append-version="true" />

    <style>
        /* NAVBAR ESTILO GLASSMORPHISM MODERNO */
        .navbar-claret-custom {
            background: rgba(18, 18, 20, 0.85) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        /* BRAND / LOGO CON GLOW */
        .brand-logo {
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: transform 0.3s ease;
        }

        .brand-container:hover .brand-logo {
            transform: scale(1.03);
        }

        .brand-badge {
            background: linear-gradient(135deg, #800e24 0%, #b21323 100%);
            padding: 6px 12px;
            border-radius: 10px;
            box-shadow: 0 0 15px rgba(178, 19, 35, 0.4);
        }

        /* ENLACES DE NAVEGACIÓN MODERNOS */
        .nav-link-modern {
            color: #a1a1aa !important;
            font-weight: 600;
            font-size: 0.95rem;
            padding: 8px 16px !important;
            border-radius: 10px;
            transition: all 0.25s ease;
        }

        .nav-link-modern:hover {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.05);
        }

        .nav-link-modern.active {
            color: #ffffff !important;
            background: rgba(128, 14, 36, 0.25);
            border: 1px solid rgba(178, 19, 35, 0.4);
        }

        /* PERFIL / BADGE DE USUARIO */
        .user-profile-card {
            background: rgba(24, 24, 27, 0.8);
            border: 1px solid #27272a;
            padding: 5px 14px 5px 6px;
            border-radius: 30px;
            transition: all 0.3s ease;
        }

        .user-profile-card:hover {
            border-color: #800e24;
            box-shadow: 0 0 12px rgba(128, 14, 36, 0.3);
        }

        .avatar-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #800e24 0%, #e63946 100%);
            color: white;
            font-weight: 700;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.4);
        }

        /* FOOTER ESTILIZADO */
        .footer-custom {
            background-color: #09090b;
            border-top: 1px solid #27272a;
        }

        .social-link {
            color: #a1a1aa;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .social-link:hover {
            color: #e63946;
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="bg-dark text-light d-flex flex-column min-vh-100" style="background-color: #0d0d0f !important;">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-md navbar-dark navbar-claret-custom py-2">
            <div class="container-fluid px-4">
                
                <!-- BRAND / LOGO -->
                <a class="navbar-brand d-flex align-items-center gap-2 brand-container me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-badge text-white">
                        <i class="bi bi-bag-heart-fill"></i>
                    </div>
                    <span class="brand-logo fs-4">Claret Style</span>
                </a>

                <!-- BOTÓN MÓVIL -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- CONTENIDO NAVEGACIÓN -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-modern d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-modern d-flex align-items-center gap-2" asp-area="" asp-controller="Producto" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap"></i> Productos
                            </a>
                        </li>
                    </ul>

                    <!-- USUARIO ADMIN BADGE -->
                    <div class="d-flex align-items-center mt-3 mt-md-0">
                        <div class="user-profile-card d-flex align-items-center gap-2">
                            <div class="avatar-circle">
                                AD
                            </div>
                            <div class="d-flex flex-column leading-none">
                                <span class="fw-bold text-white small">Admin Claret</span>
                                <small class="text-secondary" style="font-size: 0.68rem;">Administrador</small>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER MODERNO -->
    <footer class="footer-custom py-4 mt-auto">
        <div class="container text-center text-secondary small">
            <div class="mb-2">
                &copy; 2026 <strong class="text-white">Claret Style</strong> | Plataforma de E-Commerce & Control de Inventarios
            </div>
            <div class="d-flex justify-content-center gap-4 mt-2">
                <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" class="social-link fw-semibold d-flex align-items-center gap-1">
                    <i class="bi bi-instagram text-danger"></i> Instagram
                </a>
                <a href="https://www.tiktok.com" target="_blank" rel="noopener noreferrer" class="social-link fw-semibold d-flex align-items-center gap-1">
                    <i class="bi bi-tiktok text-danger"></i> TikTok
                </a>
                <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="social-link fw-semibold d-flex align-items-center gap-1">
                    <i class="bi bi-facebook text-danger"></i> Facebook
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
