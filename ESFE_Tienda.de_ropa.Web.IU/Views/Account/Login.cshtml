@{
    ViewData["Title"] = "Iniciar Sesión - Claret Style";
}

<style>
    body {
        background-color: #121212;
    }

    /* Tarjeta principal de Login */
    .card-dark-custom {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        color: #fff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card-dark-custom:hover {
        border-color: #444;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6) !important;
    }

    /* Mejora en los campos de entrada (Inputs) */
    .form-control-dark {
        background-color: #121212 !important;
        color: #ffffff !important;
        border: 1px solid #333 !important;
        transition: border-color 0.3s ease, box-shadow 0.3s ease !important;
    }

    .form-control-dark:focus {
        border-color: #800e24 !important;
        box-shadow: 0 0 10px rgba(128, 14, 36, 0.5) !important;
        outline: none !important;
    }

    /* ==========================================
       ANIMACIÓN Y DISEÑO PARA EL BOTÓN DE LOGIN
       ========================================== */
    .btn-vino {
        background: linear-gradient(135deg, #800e24, #b21323) !important;
        color: #fff !important;
        border: none !important;
        box-shadow: 0 4px 12px rgba(128, 14, 36, 0.4) !important;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    }

    /* Efecto al pasar el mouse */
    .btn-vino:hover {
        background: linear-gradient(135deg, #a0122d, #d91b2c) !important;
        color: #fff !important;
        transform: translateY(-3px) scale(1.02) !important;
        box-shadow: 0 8px 22px rgba(217, 27, 44, 0.6) !important;
    }

    /* Efecto al hacer clic */
    .btn-vino:active {
        transform: translateY(-1px) scale(0.98) !important;
        box-shadow: 0 4px 10px rgba(128, 14, 36, 0.3) !important;
    }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-4">
        <div class="card card-dark-custom p-4 shadow-lg text-center">
            <h3 class="fw-bold text-white mb-1">🔐 Claret Style</h3>
            <p class="text-secondary small mb-4">Ingresa tus credenciales para acceder al catálogo</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger p-2 small mb-3">
                    ❌ @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="text-start mb-3">
                    <label class="form-label text-secondary small">Usuario</label>
                    <input type="text" name="usuario" class="form-control form-control-dark" placeholder="Ej: admin o cliente" required autocomplete="off">
                </div>

                <div class="text-start mb-4">
                    <label class="form-label text-secondary small">Contraseña</label>
                    <input type="password" name="password" class="form-control form-control-dark" placeholder="••••••••" required>
                </div>

                <button type="submit" class="btn btn-vino w-100 fw-bold py-2 mb-3">
                    🚀 Iniciar Sesión
                </button>
            </form>

            <div class="border-top border-secondary pt-3 mt-2">
                <small class="text-secondary d-block">Credenciales de prueba:</small>
                <small class="text-warning"><b>Admin:</b> admin / admin123</small><br>
                <small class="text-info"><b>Cliente:</b> cliente / 1234</small>
            </div>
        </div>
    </div>
</div>
