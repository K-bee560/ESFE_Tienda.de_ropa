@{
    ViewData["Title"] = "Iniciar Sesión";
}

<style>
    .login-card {
        background-color: #1e1e1e;
        border: 1px solid #4a0815;
        border-radius: 12px;
        max-width: 420px;
        margin: 50px auto;
    }

    .btn-vino {
        background-color: #800e24;
        color: #ffffff;
        border: none;
    }

        .btn-vino:hover {
            background-color: #a0122d;
            color: #ffffff;
        }

    .form-control-dark {
        background-color: #2b2b2b;
        border: 1px solid #444444;
        color: #ffffff;
    }

        .form-control-dark:focus {
            background-color: #333333;
            color: #ffffff;
            border-color: #800e24;
            box-shadow: 0 0 0 0.25rem rgba(128, 14, 36, 0.4);
        }
</style>

<div class="container">
    <div class="card login-card shadow-lg p-4">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: #d1345b;">🔐 Iniciar Sesión</h2>
            <p class="text-secondary small">Ingresa tus credenciales para acceder al sistema</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 text-center" role="alert">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold">Correo Electrónico</label>
                <input type="email" name="email" class="form-control form-control-dark" placeholder="admin@tienda.com" required />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Contraseña</label>
                <input type="password" name="password" class="form-control form-control-dark" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-vino w-100 fw-bold py-2 shadow-sm">
                Ingresar al Sistema
            </button>
        </form>

        <div class="text-center mt-4 border-top border-secondary pt-3">
            <span class="text-secondary small">Datos de prueba:</span><br />
            <small class="text-warning">administradortienda@gmail.com/ Administrador1</small>
        </div>
    </div>
</div>
