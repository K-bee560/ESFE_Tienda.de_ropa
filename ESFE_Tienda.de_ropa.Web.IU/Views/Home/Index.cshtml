@{
    ViewData["Title"] = "Página Principal - Claret Style";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #2b0008 0%, #121212 100%);
        border: 1px solid #333;
        border-radius: 16px;
        padding: 60px 20px;
    }

    .card-dark-custom {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        color: #fff;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        .card-dark-custom:hover {
            transform: translateY(-5px);
            border-color: #800e24;
        }

    .btn-vino {
        background-color: #800e24;
        color: #fff;
        border: none;
    }

        .btn-vino:hover {
            background-color: #a0122d;
            color: #fff;
        }
</style>

<div class="container py-4">
    <!-- BANNER PRINCIPAL -->
    <div class="hero-section text-center text-white mb-5 shadow-lg">
        <h1 class="display-4 fw-bold mb-3">Bienvenido a <span style="color: #e63946;">Claret Style</span></h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-4" style="max-width: 600px;">
            Sistema de gestión de inventario y catálogo exclusivo para ropa urbana, formal y accesorios.
        </p>
        <a href="/Account/Login" class="btn btn-vino btn-lg fw-bold px-4 py-2 shadow">
            👔 Ver Catálogo de Productos
        </a>
    </div>

    <!-- TARJETAS DE ACCESO -->
    <div class="row g-4">
        <div class="col-md-4">
            <a href="/Account/Login" class="text-decoration-none">
                <div class="card card-dark-custom p-4 text-center h-100">
                    <div class="fs-1 mb-3">🛍️</div>
                    <h5 class="fw-bold text-white mb-2">Colección Exclusiva</h5>
                    <p class="text-secondary small mb-0">Diseños modernos organizados por categorías y prendas disponibles.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Account/Login" class="text-decoration-none">
                <div class="card card-dark-custom p-4 text-center h-100">
                    <div class="fs-1 mb-3">⚡</div>
                    <h5 class="fw-bold text-white mb-2">Gestión de Stock</h5>
                    <p class="text-secondary small mb-0">Módulo de administración de inventarios, precios y tallas.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Account/Login" class="text-decoration-none">
                <div class="card card-dark-custom p-4 text-center h-100">
                    <div class="fs-1 mb-3">🔐</div>
                    <h5 class="fw-bold text-white mb-2">Iniciar Sesión</h5>
                    <p class="text-secondary small mb-0">Acceso de seguridad para administradores y personal de tienda.</p>
                </div>
            </a>
        </div>
    </div>
</div>