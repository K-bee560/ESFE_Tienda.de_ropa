@{
    ViewData["Title"] = "Inicio";
}

<style>
    /* Tarjetas interactivas de la Home */
    .feature-card {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        color: #fff;
        text-decoration: none;
        display: block;
        transition: all 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        border-color: #800e24;
        box-shadow: 0 10px 25px rgba(128, 14, 36, 0.4);
        color: #fff;
    }

    .btn-main-cat {
        background: linear-gradient(135deg, #800e24 0%, #b21323 100%);
        color: #fff;
        border: none;
        box-shadow: 0 4px 12px rgba(128, 14, 36, 0.4);
        transition: all 0.3s ease;
    }

    .btn-main-cat:hover {
        background: linear-gradient(135deg, #a0122d 0%, #d91b2c 100%);
        color: #fff;
        transform: scale(1.03);
    }
</style>

<div class="container py-4">
    <!-- BANNER PRINCIPAL DE BIENVENIDA -->
    <div class="card card-dark-custom text-center p-5 mb-5 shadow-lg" style="background: linear-gradient(180deg, #1f1f1f 0%, #121212 100%); border: 1px solid #333; border-radius: 16px;">
        <h1 class="display-4 fw-bold text-white mb-3">Bienvenido a <span style="color: #d91b2c;">Claret Style</span></h1>
        <p class="lead text-secondary mb-4 mx-auto" style="max-width: 600px;">
            Sistema de gestión de inventario y catálogo exclusivo para ropa urbana, formal y accesorios.
        </p>
        <div>
            <!-- Direcciona a la carpeta Producto -->
            <a asp-controller="Producto" asp-action="Index" class="btn btn-main-cat btn-lg px-4 py-2 fw-bold rounded-pill">
                👖 Ver Catálogo de Productos
            </a>
        </div>
    </div>

    <!-- TARJETAS FUNCIONALES -->
    <div class="row g-4">
        <!-- 1. COLECCIÓN EXCLUSIVA -->
        <div class="col-md-4">
            <a asp-controller="Producto" asp-action="Index" class="feature-card p-4 text-center h-100">
                <div class="fs-1 mb-2">🛍️</div>
                <h5 class="fw-bold text-white mb-2">Colección Exclusiva</h5>
                <p class="text-secondary small mb-0">Diseños modernos organizados por categorías, tallas y carrito de compras.</p>
            </a>
        </div>

        <!-- 2. GESTIÓN DE STOCK -->
        <div class="col-md-4">
            <a asp-controller="Producto" asp-action="Index" class="feature-card p-4 text-center h-100">
                <div class="fs-1 mb-2">⚡</div>
                <h5 class="fw-bold text-white mb-2">Gestión de Stock</h5>
                <p class="text-secondary small mb-0">Módulo de administración de inventarios, auditoría Kardex y métricas.</p>
            </a>
        </div>

        <!-- 3. INICIAR SESIÓN -->
        <div class="col-md-4">
            <a asp-controller="Account" asp-action="Login" class="feature-card p-4 text-center h-100">
                <div class="fs-1 mb-2">🔐</div>
                <h5 class="fw-bold text-white mb-2">Iniciar Sesión</h5>
                <p class="text-secondary small mb-0">Acceso de seguridad para administradores, vendedores y clientes.</p>
            </a>
        </div>
    </div>
</div>
