@{
    ViewData["Title"] = "Página Principal - Claret Style";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #2b0008 0%, #121212 100%);
        border: 1px solid #333;
        border-radius: 16px;
        padding: 60px 20px;
    }

    .card-dark-custom {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 12px;
        color: #fff;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .card-dark-custom:hover {
        transform: translateY(-5px);
        border-color: #800e24;
    }

    .btn-vino {
        background: linear-gradient(135deg, #800e24, #b21323) !important;
        color: #fff !important;
        border: none !important;
        box-shadow: 0 4px 12px rgba(128, 14, 36, 0.4) !important;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
        display: inline-block;
    }

    .btn-vino:hover {
        background: linear-gradient(135deg, #a0122d, #d91b2c) !important;
        color: #fff !important;
        transform: translateY(-4px) scale(1.03) !important;
        box-shadow: 0 8px 25px rgba(217, 27, 44, 0.6) !important;
    }

    .btn-vino:active {
        transform: translateY(-1px) scale(0.98) !important;
        box-shadow: 0 4px 10px rgba(128, 14, 36, 0.3) !important;
    }
</style>

<div class="container py-4">
    <!-- BANNER PRINCIPAL -->
    <div class="hero-section text-center text-white mb-5 shadow-lg">
        <h1 class="display-4 fw-bold mb-3">Bienvenido a <span style="color: #e63946;">Claret Style</span></h1>
        <p class="lead text-secondary max-w-2xl mx-auto mb-4" style="max-width: 600px;">
            Sistema de gestión de inventario y catálogo exclusivo para ropa urbana, formal y accesorios.
        </p>
        <a href="#catalogo" class="btn btn-vino btn-lg fw-bold px-4 py-2 shadow">
            👔 Ver Catálogo de Productos
        </a>
    </div>

    <!-- TARJETAS DE ACCESO -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <a href="/Account/Login" class="text-decoration-none">
                <div class="card card-dark-custom p-4 text-center h-100">
                    <div class="fs-1 mb-3">🛍️</div>
                    <h5 class="fw-bold text-white mb-2">Colección Exclusiva</h5>
                    <p class="text-secondary small mb-0">Diseños modernos organizados por categorías y prendas disponibles.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Account/Login" class="text-decoration-none">
                <div class="card card-dark-custom p-4 text-center h-100">
                    <div class="fs-1 mb-3">⚡</div>
                    <h5 class="fw-bold text-white mb-2">Gestión de Stock</h5>
                    <p class="text-secondary small mb-0">Módulo de administración de inventarios, precios y tallas.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Account/Login" class="text-decoration-none">
                <div class="card card-dark-custom p-4 text-center h-100">
                    <div class="fs-1 mb-3">🔐</div>
                    <h5 class="fw-bold text-white mb-2">Iniciar Sesión</h5>
                    <p class="text-secondary small mb-0">Acceso de seguridad para administradores y personal de tienda.</p>
                </div>
            </a>
        </div>
    </div>

    <!-- SECCIÓN DE CATÁLOGO DESTACADO -->
    <div id="catalogo" class="mb-5">
        <h3 class="fw-bold text-white mb-4">🔥 Colección Destacada</h3>
        <div class="row g-4">

            <!-- PRENDA 1: SUDADERA URBAN HOODIE -->
            <div class="col-md-3">
                <div class="card card-dark-custom h-100 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Sudadera Urban Hoodie" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-secondary">Unisex</span>
                            <small class="text-secondary">🎨 Gris Jaspe</small>
                        </div>
                        <h6 class="fw-bold text-white mb-2">Sudadera Urban Hoodie</h6>
                        <div class="d-flex justify-content-between align-items-center my-2">
                            <span class="text-warning fw-bold">$42.00</span>
                            <span class="badge bg-success">15 dispon.</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small mb-1">Seleccionar Talla:</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary">
                                <option>S</option>
                                <option selected>M</option>
                                <option>L</option>
                                <option>XL</option>
                            </select>
                        </div>
                        <a href="/Account/Login" class="btn btn-vino btn-sm w-100 mt-auto fw-bold">🛒 Comprar / Agregar</a>
                    </div>
                </div>
            </div>

            <!-- PRENDA 2: BLUSA SATINADA SATIN -->
            <div class="col-md-3">
                <div class="card card-dark-custom h-100 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Blusa Satinada Satin" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-secondary">Femenino</span>
                            <small class="text-secondary">🎨 Blanco Perla</small>
                        </div>
                        <h6 class="fw-bold text-white mb-2">Blusa Satinada Satin</h6>
                        <div class="d-flex justify-content-between align-items-center my-2">
                            <span class="text-warning fw-bold">$29.99</span>
                            <span class="badge bg-success">8 dispon.</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small mb-1">Seleccionar Talla:</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary">
                                <option selected>S</option>
                                <option>M</option>
                                <option>L</option>
                            </select>
                        </div>
                        <a href="/Account/Login" class="btn btn-vino btn-sm w-100 mt-auto fw-bold">🛒 Comprar / Agregar</a>
                    </div>
                </div>
            </div>

            <!-- PRENDA 3: BLAZER EJECUTIVO PREMIUM -->
            <div class="col-md-3">
                <div class="card card-dark-custom h-100 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1594938298603-c8148c4dae35?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Blazer Ejecutivo Premium" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-secondary">Masculino</span>
                            <small class="text-secondary">🎨 Azul Marino</small>
                        </div>
                        <h6 class="fw-bold text-white mb-2">Blazer Ejecutivo Premium</h6>
                        <div class="d-flex justify-content-between align-items-center my-2">
                            <span class="text-warning fw-bold">$95.00</span>
                            <span class="badge bg-success">6 dispon.</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small mb-1">Seleccionar Talla:</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary">
                                <option>38R</option>
                                <option selected>40R</option>
                                <option>42R</option>
                            </select>
                        </div>
                        <a href="/Account/Login" class="btn btn-vino btn-sm w-100 mt-auto fw-bold">🛒 Comprar / Agregar</a>
                    </div>
                </div>
            </div>

            <!-- PRENDA 4: CAMISETA OVERSIZE STREETWEAR -->
            <div class="col-md-3">
                <div class="card card-dark-custom h-100 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=600&q=80" class="card-img-top" alt="Camiseta Oversize Streetwear" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column p-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-secondary">Unisex</span>
                            <small class="text-secondary">🎨 Blanco Cotton</small>
                        </div>
                        <h6 class="fw-bold text-white mb-2">Camiseta Oversize Streetwear</h6>
                        <div class="d-flex justify-content-between align-items-center my-2">
                            <span class="text-warning fw-bold">$25.00</span>
                            <span class="badge bg-success">18 dispon.</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-secondary small mb-1">Seleccionar Talla:</label>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary">
                                <option>S</option>
                                <option selected>M</option>
                                <option>L</option>
                                <option>XL</option>
                            </select>
                        </div>
                        <a href="/Account/Login" class="btn btn-vino btn-sm w-100 mt-auto fw-bold">🛒 Comprar / Agregar</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- SECCIÓN DE UBICACIÓN Y CONTACTO CON MAPA INTERACTIVO -->
    <div class="card card-dark-custom p-4 mb-4">
        <div class="row align-items-center">
            <div class="col-md-5 mb-3 mb-md-0">
                <h4 class="fw-bold text-white mb-3">📍 Visita Nuestra Tienda Física</h4>
                <p class="text-secondary mb-2"><b>Dirección:</b> Centro Comercial Galería Claret, Local 12-B, Nivel 2, San Salvador.</p>
                <p class="text-secondary mb-2"><b>Teléfono de Atención:</b> 📞 +503 7219-5424</p>
                <p class="text-secondary mb-2"><b>Atención por WhatsApp:</b> 💬 +503 7219-5424</p>
                <p class="text-secondary mb-0"><b>Horarios:</b> Lunes a Sábado: 9:00 AM - 7:00 PM | Domingos: 10:00 AM - 5:00 PM</p>
            </div>
            <div class="col-md-7">
                <div class="position-relative overflow-hidden rounded border border-secondary shadow-sm" style="height: 240px;">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3876.126046294717!2d-89.2366113!3d13.7003468!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f633047247738f7%3A0xb3a056a287c8d76!2sPaseo%20General%20Escal%C3%B3n%2C%20San%20Salvador!5e0!3m2!1ses!2ssv!4v1710000000000!5m2!1ses!2ssv" 
                        width="100%" 
                        height="100%" 
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                    <div class="position-absolute bottom-0 start-0 w-100 p-1 bg-dark bg-opacity-75 text-center" style="pointer-events: none;">
                        <small class="text-white fw-semibold">📍 Sucursal Escalón - San Salvador, El Salvador</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
